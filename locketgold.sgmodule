#!url=https://raw.githubusercontent.com/vinh123az123az2-ship-it/locket-gold/refs/heads/master/locketgold.sgmodule
#!name=Locket Gold VIP - langtucamau
#!desc=Mở khóa Locket Gold VIP + AI Filter + Photobooth. Hỗ trợ bởi langtucamau.
#!author=langtucamau
#!homepage=https://github.com/vinh123az123az2-ship-it/locket-gold
#!tgchannel=https://github.com/vinh123az123az2-ship-it/locket-gold
#!icon=https://raw.githubusercontent.com/vinh123az123az2-ship-it/locket-gold/refs/heads/master/assets/banner.png

[Rule]
# CHẶN SẠCH QUIC/HTTP3: UDP 443 (cú pháp DOMAIN+UDP không ăn trên luồng UDP thô → ép TCP)
AND,((PROTOCOL,UDP),(DEST-PORT,443)),REJECT
# Chặn QUIC/HTTP3 (UDP) để ép app dùng TCP → Shadowrocket MITM mới chặn được
AND,((DOMAIN,firebaseremoteconfig.googleapis.com),(PROTOCOL,UDP)),REJECT
AND,((DOMAIN,api.revenuecat.com),(PROTOCOL,UDP)),REJECT
AND,((DOMAIN,api.rc-backup.com),(PROTOCOL,UDP)),REJECT
AND,((DOMAIN,api.locketcamera.com),(PROTOCOL,UDP)),REJECT
AND,((DOMAIN-SUFFIX,locketcamera.com),(PROTOCOL,UDP)),REJECT
AND,((DOMAIN,us-central1-locket-4252a.cloudfunctions.net),(PROTOCOL,UDP)),REJECT

[Host]
firebaseremoteconfigrealtime.googleapis.com = 0.0.0.0

[Script]
# === CORE: Mở khóa Gold VIP ===
revenuecat = type=http-response, pattern=^https:\/\/api\.(revenuecat|rc-backup)\.com\/.+\/(receipts$|subscribers\/[^/]+$), script-path=https://raw.githubusercontent.com/vinh123az123az2-ship-it/locket-gold/refs/heads/master/locketgold/locketgold.js?v=20261120_v18, requires-body=true, max-size=-1, timeout=60

# === CORE: Xóa ETag cache (RevenueCat + Firebase Remote Config) ===
# Firebase phải strip cache header, nếu không app ăn 304 → xài config free cũ → MẤT ICON
deleteHeader = type=http-request, pattern=^https:\/\/(api\.(revenuecat|rc-backup)\.com\/.+\/(receipts|subscribers)|firebaseremoteconfig\.googleapis\.com\/v1\/.+), script-path=https://raw.githubusercontent.com/vinh123az123az2-ship-it/locket-gold/refs/heads/master/locketgold/deleteHeader.js?v=20261119_v16, timeout=60

# === CORE: Firebase Remote Config unlock ===
locket_rc = type=http-response, pattern=^https?:\/\/firebaseremoteconfig\.googleapis\.com\/v1\/projects\/[^\/]+\/.+, script-path=https://raw.githubusercontent.com/vinh123az123az2-ship-it/locket-gold/refs/heads/master/locketgold/locket_remote.js?v=20261120_v18, requires-body=true, max-size=-1, timeout=60

# === CORE: Badge Gold + Moment Unlocker ===
locket_badge = type=http-request, pattern=^https:\/\/api\.locketcamera\.com\/changeProfileInfo, script-path=https://raw.githubusercontent.com/vinh123az123az2-ship-it/locket-gold/refs/heads/master/locketgold/locket_profile.js?v=20261119_v16, timeout=60
locket_user = type=http-response, pattern=^https:\/\/api\.locketcamera\.com\/.+, script-path=https://raw.githubusercontent.com/vinh123az123az2-ship-it/locket-gold/refs/heads/master/locketgold/locket_profile.js?v=20261119_v16, requires-body=true, max-size=-1, timeout=60

# === AI FILTER: Unblur native AI filter của Locket (ai_anime, ai_ghibli...) ===
locket_filter_fix = type=http-request, pattern=^https?:\/\/(api\.locketcamera\.com|us-central1-locket-4252a\.cloudfunctions\.net)\/.*generateFilteredImage, script-path=https://raw.githubusercontent.com/vinh123az123az2-ship-it/locket-gold/refs/heads/master/locketgold/locket_filter_v5.js?v=20261119_v5a, requires-body=true, max-size=-1, timeout=60

# === AI FILTER (CUSTOM): TẮT TẠM — binary-body-mode buffer cả video 60s → ĐEN MÀN xem lại ===
# Pattern (moments|upload|post|moment) nuốt luôn upload video. Bật lại ở bản rebuild AI pipeline
# với pattern hẹp (chỉ ảnh) + bỏ binary-body-mode cho video.
# locket_ai_filter = type=http-request, pattern=^https:\/\/(api|cdn)\.locketcamera\.com\/.+(moments|upload|post|moment), script-path=https://raw.githubusercontent.com/vinh123az123az2-ship-it/locket-gold/refs/heads/master/locketgold/locket_ai.js?v=20261119_v16, requires-body=true, binary-body-mode=true, timeout=60

[MITM]
hostname = %APPEND% api.revenuecat.com, api.rc-backup.com, firebaseremoteconfig.googleapis.com, api.locketcamera.com, cdn.locketcamera.com, *.locketcamera.com, us-central1-locket-4252a.cloudfunctions.net
